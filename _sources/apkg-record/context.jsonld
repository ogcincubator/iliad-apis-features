{
  "@context": {
    "xsd":      "http://www.w3.org/2001/XMLSchema#",
    "sh":       "http://www.w3.org/ns/shacl",
    "dct":      "http://purl.org/dc/terms/",
    "dcat":     "http://www.w3.org/ns/dcat#",
    "time":     "http://www.w3.org/2006/time#",
    "schema":   "https://schema.org/",
    "apkg":     "http://w3id.org/apkg/terms#",
    "cwl":      "https://w3id.org/cwl/cwl#",
    "class":    "dct:type",
    "cwltool":  "http://commonwl.org/cwltool#",
    "Secrets":  "cwltool:Secrets",
    "geojson":  "https://purl.org/geojson/vocab#",

    "type": { "@id": "@type" },
    "id":   { "@id": "@id" },

    "geometry": "apkg:hasGeometry",

    "properties": {
      "@id": "@nest",
      "@context": {
        "identifier": { "@id": "dct:identifier", "@type": "xsd:anyURI" },
        "id":         { "@id": "schema:identifier" },
        "family":     { "@id": "apkg:family", "@type": "xsd:anyURI" },
        "latest":     "apkg:latest",
        "class":      "dct:type",
        "label":      "apkg:label",

        "name":                 "schema:name",
        "description":          "schema:description",
        "email":                "schema:email",
        "keywords":             "schema:keywords",
        "software_version":     "schema:softwareVersion",
        "programming_language": "schema:programmingLanguage",
        "file_format":          "schema:fileFormat",

        "cwl": { "@id": "apkg:cwl" },

        "url":              { "@id": "schema:url", "@type": "xsd:anyURI" },
        "registration_url": { "@id": "apkg:originalURL", "@type": "xsd:anyURI" },
        "code_repository":  { "@id": "schema:codeRepository", "@type": "xsd:anyURI" },

        "license":      { "@id": "schema:license", "@type": "xsd:anyURI" },
        "citation":     "schema:citation",
        "date_created": { "@id": "schema:dateCreated", "@type": "xsd:date" },
        "sdDatePublished": {
          "@id": "schema:sdDatePublished",
          "@type": "xsd:dateTime"
        },

        "author":              "schema:author",
        "contributor":         "schema:contributor",
        "maintainer":          "schema:maintainer",
        "producer":            "schema:producer",
        "source_organization": "schema:sourceOrganization",
        "sdPublisher":         "schema:sdPublisher",
        "publisher":           "schema:publisher",

        "spatial_coverage":  "schema:spatialCoverage",
        "temporal_coverage": "apkg:hasTemporalCoverage",
        "inXSDDateTime":     "time:inXSDDateTime",
        "hasBeginning":      "time:hasBeginning",
        "hasEnd":            "time:hasEnd",

        "inputs":  "apkg:hasInput",
        "outputs": "apkg:hasOutput",

        "links": {
          "@id": "apkg:hasLink",
          "@context": {
            "rel":   "dct:type",
            "type":  "dcat:mediaType",
            "href":  { "@id": "schema:url", "@type": "xsd:anyURI" },
            "title": "dct:title"
          }
        },

        "Secrets": "cwltool:Secrets"
      }
    }
  }
}

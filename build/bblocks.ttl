<bblocks://ogc.hosted.iliad.api.features.nina-seapop-oim> a skos:Concept,
        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Schema ;
    rdfs:label "NINA SEAPOP — OIM Target Model" ;
    dct:abstract "OIM-aligned GeoJSON Feature representation of NINA SEAPOP seabird colony observations, extending oim-bio-tdwg (Darwin Core). Adds colonyID as a persistent URI identifying the nesting site (derived from the source locality field), enabling time-series queries per colony as sosa:hasFeatureOfInterest. Only source-derived fields are added; OBIS enrichment fields (bathymetry, shoredistance, sst, sss, aphiaID) are excluded from the schema."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2026-05-05T00:00:00+00:00"^^xsd:dateTime ;
    dct:description [ dct:format "text/html" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/iliad-apis-features/bblock/ogc.hosted.iliad.api.features.nina-seapop-oim> ],

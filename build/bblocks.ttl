    dct:source <https://api.dive.edito.eu/data/collections/emodnet-occurrence_data>,
        <https://dwc.tdwg.org/terms/>,
        <https://s3.waw3-1.cloudferro.com/emodnet/emodnet_biology/12639/>,
        <https://www.marinespecies.org/> ;
    skos:inScheme <https://ogcincubator.github.io/iliad-apis-features/> ;
    skos:prefLabel "EMODnet Biology Occurrences (GeoParquet)" ;

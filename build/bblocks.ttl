            prof:hasArtifact <https://ogcincubator.github.io/iliad-apis-features/build/annotated/hosted/iliad/api/features/apkg-record/schema.yaml> ;
            prof:hasRole role:schema ],
        [ dct:conformsTo shacl: ;
            dct:format "text/turtle" ;
            rdfs:seeAlso <bblocks://ogc.hosted.iliad.api.features.apkg> ;
            prof:hasArtifact <https://ogcincubator.github.io/iliad-apis-features/_sources/apkg/rules.shacl> ;
            prof:hasRole role:validation ],
        [ dct:conformsTo shacl: ;

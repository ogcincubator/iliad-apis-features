<bblocks://ogc.hosted.iliad.api.features.apkg-record> a skos:Concept,
        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Schema ;
    rdfs:label "ILIAD APKG Registry Record" ;
    dct:abstract "OGC API Records profile for the ILIAD Application Package registry hosted at https://iliad-registry.inesctec.pt. Each register item is a GeoJSON Feature describing one Application Package (CWL CommandLineTool or Workflow) with metadata covering identifier and family, software version, authors and organisations, programming language, inputs and outputs as CWL parameters, embedded CWL document, spatial and temporal coverage, license, citation, and provenance. Extends the GeoDCAT mapping for OGC API Records and reuses the APKG metadata profile (apkg:) for ApplicationPackage, Process, Parameter, Geometry and TemporalCoverage terms."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2026-05-05T00:00:00+00:00"^^xsd:dateTime ;
    dct:description [ dct:format "text/markdown" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/iliad-apis-features/build/generateddocs/markdown/hosted/iliad/api/features/apkg-record/index.md> ],
        [ dct:format "application/json" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/iliad-apis-features/build/generateddocs/json-full/hosted/iliad/api/features/apkg-record/index.json> ],
        [ dct:format "text/html" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/iliad-apis-features/bblock/ogc.hosted.iliad.api.features.apkg-record> ] ;
    dct:hasVersion "0.1" ;
    dct:modified "2026-05-26"^^xsd:date ;
    dct:source <https://github.com/ILIAD-ocean-twin/APKG/blob/main/terms/apkg-ms.ttl>,
        <https://iliad-registry.inesctec.pt/collections/apkg>,
        <https://iliad-registry.inesctec.pt/collections/apkg/items>,
        <https://iliad-registry.inesctec.pt/collections/apkg/schema>,
        <https://ogcapi.ogc.org/records/>,
        <https://ogcincubator.github.io/geodcat-ogcapi-records/bblock/ogc.geo.geodcat.geodcat-records/>,
        <https://www.commonwl.org/> ;
    skos:inScheme <https://ogcincubator.github.io/iliad-apis-features/> ;
    skos:prefLabel "ILIAD APKG Registry Record" ;
    skos:topConceptOf <https://ogcincubator.github.io/iliad-apis-features/> ;
    dcat:keyword "apkg",
        "application-package",
        "catalog",
        "cwl",
        "iliad",
        "ogc-records",
        "registry" ;
    prof:hasResource [ dct:conformsTo <https://www.w3.org/TR/json-ld11/> ;
            dct:format "application/ld+json" ;
            prof:hasArtifact <https://ogcincubator.github.io/iliad-apis-features/build/annotated/hosted/iliad/api/features/apkg-record/context.jsonld> ;
            prof:hasRole role:mapping ],

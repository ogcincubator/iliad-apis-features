<bblocks://ogc.hosted.iliad.api.features.nina-seapop-catalog> a skos:Concept,
        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Schema ;
    rdfs:label "NINA SEAPOP — Catalog / Discovery Metadata" ;
    dct:abstract "OGC API Records and STAC Collection metadata record for the NINA SEAPOP seabird colony observation dataset. Encodes discovery metadata including spatial coverage (Norway + Svalbard), temporal extent (2014–present), provider (NINA), license (CC-BY 4.0), and links to both the raw OBIS occurrence API (source mode) and the OIM GeoJSON Features endpoint (target mode). Implements OGC Records with relevant STAC extensions."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2026-05-05T00:00:00+00:00"^^xsd:dateTime ;
    dct:description [ dct:format "application/json" ;

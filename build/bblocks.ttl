<bblocks://ogc.hosted.iliad.api.features.nina-seapop-source> a skos:Concept,
        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Schema ;
    rdfs:label "NINA SEAPOP Source — OBIS Occurrence Record" ;
    dct:abstract "Source-faithful representation of a single occurrence record as returned by the OBIS v3 occurrence API for the NINA SEAPOP seabird colony monitoring dataset (dataset ID 561441ab-128b-4be7-8fce-de1ef79855da). Encodes the raw flat JSON structure including both original Darwin Core fields and OBIS-enrichment fields (bathymetry, shoredistance, sst, sss, aphiaID). Intended as the source-side contract in a source→target transformation pipeline."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2026-05-05T00:00:00+00:00"^^xsd:dateTime ;
    dct:description [ dct:format "text/markdown" ;

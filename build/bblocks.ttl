<bblocks://ogc.hosted.iliad.api.features.emodnet-biology-occurrences> a skos:Concept,
        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Schema ;
    rdfs:label "EMODnet Biology Occurrences (GeoParquet)" ;
    dct:abstract "Darwin Core occurrence records of marine biodiversity from EMODnet Biology, packaged as GeoParquet 1.0.0, accessed via the EDITO STAC catalog. Covers global marine species observations with WoRMS Aphia identifiers, taxon hierarchy, sampling metadata, and WKB-encoded Point geometries."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2026-05-22T00:00:00+00:00"^^xsd:dateTime ;
    dct:description [ dct:format "application/json" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/iliad-apis-features/build/generateddocs/json-full/hosted/iliad/api/features/emodnet-biology-occurrences/index.json> ],
